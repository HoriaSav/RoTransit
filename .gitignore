otp/graphs/
otp/**/*.log
otp/tmp/
otp/temp/
otp/.cache/
# Accidental large dataset drops at otp/ root (use ignored gtfs/ and osm/ instead)
otp/*.pbf
otp/*.osm
otp/*.osm.pbf
otp/*.zip

